# Email OTP kit settings. Copy this file to .env and fill in the two credentials.
#   cp .env.example .env
# .env is git-ignored: it never reaches GitHub.

# ---- Credentials (the only two lines you must fill in) ----
# The Gmail address the codes are sent from.
SMTP_USER=
# A 16-character Google App Password for that address (NOT your normal Gmail password).
# Get one at https://myaccount.google.com/apppasswords (needs 2-Step Verification). See GUIDE.md.
SMTP_PASS=

# ---- Mail server (ready for Gmail; change only for another provider) ----
SMTP_HOST=smtp.gmail.com
# 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true (SSL)
SMTP_PORT=587
SMTP_SECURE=false
# Name shown as the sender. The address is always SMTP_USER (Gmail rewrites any other).
MAIL_FROM_NAME=My App

# ---- OTP rules ----
OTP_LENGTH=6
OTP_TTL_MINUTES=10
# Wrong guesses allowed before the code is thrown away
OTP_MAX_ATTEMPTS=5
# Seconds before another code can be sent to the same person
OTP_RESEND_SECONDS=60

# ---- Demo server ----
PORT=4600
